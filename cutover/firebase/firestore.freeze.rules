rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cutover-only rule set: deny every client operation after maintenance
    // begins. Export and verification use privileged server credentials and do
    // not depend on client rules. Restore the archived rules only on rollback.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

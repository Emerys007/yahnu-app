# Local PostgreSQL (see docker-compose.yml)
DATABASE_URL=postgresql://yahnu:yahnu_dev@127.0.0.1:5432/yahnu
# DATABASE_POOL_URL=postgresql://... # Optional PgBouncer URL for runtime only
DATABASE_POOL_MAX=10

# Use a long random value. Render generates this automatically from render.yaml.
AUTH_SECRET=replace-with-at-least-32-random-bytes
APP_URL=http://localhost:3000

# Optional transactional email. Without these, local verification/reset links are shown in the UI.
RESEND_API_KEY=
EMAIL_FROM=Yahnu <accounts@example.com>

# Optional Google OpenID Connect. Callback: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_OPENCAGE_API_KEY=
NEXT_PUBLIC_ENABLE_HUBSPOT=false
GEMINI_API_KEY=
YAHNU_ENABLE_AI=false
YAHNU_GEMINI_MODEL=gemini-3.5-flash

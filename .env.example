# Local PostgreSQL (see docker-compose.yml)
DATABASE_URL=postgresql://yahnu:yahnu_dev@127.0.0.1:5432/yahnu
# Optional PgBouncer URL for runtime only. A non-empty value takes precedence over
# DATABASE_URL and must not contain a query string or fragment. Omitted ports are
# normalized to the standard PostgreSQL port (5432), never inherited from PGPORT.
# DATABASE_POOL_URL=postgresql://...
DATABASE_POOL_MAX=10

# Leave unset (or use "disable") for the local Docker database. App and cutover URLs
# never accept ?sslmode=... because node-postgres lets URL options override TLS settings.
# For an external Render URL, set PGSSLMODE=verify-full (or require) to require
# certificate validation. Keep an internal private-network URL non-TLS unless its
# endpoint has been independently verified to support TLS.
# PGSSLMODE=verify-full
# For a private CA, set exactly one of these to a PEM certificate. DATABASE_SSL_CA is
# useful for a platform secret environment variable; DATABASE_SSL_CA_FILE is useful
# for a mounted secret file. PGSSLROOTCERT is accepted as a file-path compatibility alias.
# For a self-signed internal endpoint, pair the private CA/leaf pin with its exact
# certificate DNS/CN identity. This preserves hostname verification; it is not a bypass.
# node-postgres still sends SNI for the database URL host, so that endpoint must return
# the intended certificate for that SNI value before this identity override is checked.
# Optionally pin the exact expected leaf DER SHA-256 (hex or colon-separated hex).
# DATABASE_SSL_CA=
# DATABASE_SSL_CA_FILE=/path/to/postgres-ca.pem
# DATABASE_SSL_SERVERNAME=
# DATABASE_SSL_CERT_SHA256=

# Use a long random value. Render generates this automatically from render.yaml.
AUTH_SECRET=replace-with-at-least-32-random-bytes
APP_URL=http://localhost:3000

# Transactional email is mandatory outside local development.
RESEND_API_KEY=
EMAIL_FROM=Yahnu <accounts@example.com>
# Local-only escape hatch: keep false in every hosted environment. Set true only
# with NODE_ENV=development and a loopback APP_URL to show local verification/reset links.
YAHNU_ALLOW_LOCAL_EMAIL_DEBUG=false

# Optional Google OpenID Connect. Callback: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_OPENCAGE_API_KEY=
GEMINI_API_KEY=
YAHNU_ENABLE_AI=false
YAHNU_GEMINI_MODEL=gemini-3.5-flash

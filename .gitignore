# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/
/output/playwright/

# next.js
/.next/
/out/

# production
/build
/work

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.npm-cache*/
/.tools/
/.lock-rebuild/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*
!.env.example

# legacy migration exports can contain personal data
/firebase-export*.json
/firebase-*.json
/yahnu-auth*.json
/yahnu-firestore*.json
/yahnu-storage*/
/firebase-storage*/
/storage-manifest*.json
/media-url-rewrites*.json
/migration-data/

# Skills-check banks contain protected assessment content. Production banks
# belong in a Render Secret File, never in source control.
/skills-bank*.json
/secrets/
/db/private-skills/
